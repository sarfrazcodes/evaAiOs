[Unit]
Description=EVA AI OS Core Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aegis
EnvironmentFile=-/etc/eva/eva.env
Environment=EVA_ROOT=/home/aegis/Desktop/evaAiOs
WorkingDirectory=${EVA_ROOT}
ExecStart=${EVA_ROOT}/venv/bin/uvicorn core.eva_core.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
