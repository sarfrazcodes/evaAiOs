[Unit]
Description=EVA AI OS Desktop Shell
After=eva-core.service
Requires=eva-core.service

[Service]
Type=simple
User=aegis
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
WorkingDirectory=/home/aegis/Desktop/evaAiOs/desktop/eva_desktop
ExecStart=/home/aegis/Desktop/evaAiOs/desktop/eva_desktop/build/linux/x64/release/bundle/eva_desktop
Restart=on-failure

[Install]
WantedBy=graphical.target
